# ─── Marang Archive — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to the repository.
# This file contains ONLY key names — no actual values.

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=
PORT=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=

# ─── Authentication ───────────────────────────────────────────────────────────
# Minimum 32 characters of cryptographically random entropy
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Optional: additional pepper applied before hashing (argon2id)
ARGON2_PEPPER=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PUBLIC_MAX=
RATE_LIMIT_PUBLIC_WINDOW_MS=
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_AUTH_WINDOW_MS=

# ─── Background Jobs ──────────────────────────────────────────────────────────
UPDATE_CHECK_CRON=
HEALTH_CHECK_CRON=

# ─── Source Adapters ──────────────────────────────────────────────────────────
# Add per-adapter environment variables here as adapters are implemented.
# Example format (do not add real keys here):
# SOURCE_EXAMPLE_API_KEY=
# SOURCE_EXAMPLE_BASE_URL=
